<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.HpRemoteAgent">

        <!-- Re-declares the library's activity just to attach the launcher
             intent-filter for this standalone build - see feature-remote's
             manifest for why it isn't declared there. tools:replace is
             required because the library declares exported="false". -->
        <activity
            android:name="com.hpremote.agent.MainActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
