<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결 방식"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_method_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_wifi_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="같은 Wi-Fi" />

            <RadioButton
                android:id="@+id/radio_hotspot_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="핫스팟" />

            <RadioButton
                android:id="@+id/radio_wifi_direct_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Direct (가장 빠름, 공유기 불필요)" />

            <RadioButton
                android:id="@+id/radio_relay_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인터넷 경유 (다른 네트워크에서도 가능, 느릴 수 있음)" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#33000000" />

        <LinearLayout
            android:id="@+id/layout_local_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/text_local_hint_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="두 폰이 같은 공유기 Wi-Fi에 연결되어 있어야 합니다"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="이 폰의 IP 주소"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="192.168.0.5" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_wifi_direct_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="아래 버튼을 눌러 Wi-Fi Direct 대기를 시작하세요"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_wifi_direct_status_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_relay_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="릴레이 서버 주소"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edit_relay_url_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textUri"
                android:autofillHints="" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PIN"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="123456" />

        <Button
            android:id="@+id/btn_start_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="받기 대기 시작" />

        <TextView
            android:id="@+id/text_category_index_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_category_receive"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="전체 진행률"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress_overall_receive"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/text_status_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="대기 중"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
