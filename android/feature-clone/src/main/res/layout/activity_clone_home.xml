<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="같은 Wi-Fi에 연결된 두 폰끼리 연락처·통화기록·캘린더·문자·사진·동영상·설치 앱 목록을 직접 전송합니다. 서버를 거치지 않습니다."
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="이 폰의 데이터 보내기 (기존 폰)" />

        <Button
            android:id="@+id/btn_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="새 폰으로 데이터 받기" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="참고: 앱 자체를 지우지 않는 한, 안드로이드 보안 정책상 게임 저장 데이터 등 앱 내부 데이터와 Wi-Fi 비밀번호는 루팅 없이는 옮길 수 없습니다. 설치된 앱은 목록만 전달되며 새 폰에서 각각 다시 설치해야 합니다."
            android:textSize="12sp"
            android:textColor="#88000000" />

    </LinearLayout>
</ScrollView>
