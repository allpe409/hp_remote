<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결 방식"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_method_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_wifi_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="같은 Wi-Fi" />

            <RadioButton
                android:id="@+id/radio_hotspot_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="핫스팟" />

            <RadioButton
                android:id="@+id/radio_wifi_direct_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Direct (가장 빠름, 공유기 불필요)" />

            <RadioButton
                android:id="@+id/radio_relay_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인터넷 경유 (다른 네트워크에서도 가능, 느릴 수 있음)" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#33000000" />

        <LinearLayout
            android:id="@+id/layout_local_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_local_hint_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="두 폰이 같은 공유기 Wi-Fi에 연결되어 있어야 합니다"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="새 폰에 표시된 IP를 입력하세요"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edit_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="192.168.0.5"
                android:inputType="textUri"
                android:autofillHints="" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_wifi_direct_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_scan_peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주변 기기 검색" />

            <ListView
                android:id="@+id/list_peers"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_wifi_direct_status_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_relay_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="릴레이 서버 주소"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edit_relay_url_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textUri"
                android:autofillHints="" />

        </LinearLayout>

        <EditText
            android:id="@+id/edit_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="PIN 6자리"
            android:inputType="number"
            android:maxLength="6"
            android:autofillHints="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="보낼 데이터 선택"
            android:textSize="14sp" />

        <!-- 앱목록: 정보성 목록뿐 - 새 폰에서 Play스토어로 재설치하라는 안내용, 실제 파일 복사 없음 -->
        <LinearLayout
            android:id="@+id/header_apps_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_apps_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앱목록"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_apps_summary_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="불러오는 중..."
                android:textSize="12sp" />

        </LinearLayout>

        <ListView
            android:id="@+id/list_apps_send"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="4dp"
            android:choiceMode="multipleChoice" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#33000000" />

        <!-- 파일분류: 연락처~동영상 8종은 건수/용량을 바로 조회해 오름차순 정렬, 압축파일~기타 4종은 폴더 지정 방식 -->
        <LinearLayout
            android:id="@+id/header_files_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_files_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="파일분류"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_files_summary_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0개 선택됨"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_known_file_categories_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cb_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="연락처" />

            <CheckBox
                android:id="@+id/cb_call_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="통화 기록" />

            <CheckBox
                android:id="@+id/cb_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="캘린더" />

            <CheckBox
                android:id="@+id/cb_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="문자 메시지" />

            <CheckBox
                android:id="@+id/cb_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="사진" />

            <CheckBox
                android:id="@+id/cb_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="음악" />

            <CheckBox
                android:id="@+id/cb_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="음성 파일" />

            <CheckBox
                android:id="@+id/cb_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="동영상" />

        </LinearLayout>

        <!-- 압축 파일 -->
        <CheckBox
            android:id="@+id/cb_archive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="압축 파일" />

        <LinearLayout
            android:id="@+id/layout_archive_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pick_archive_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="폴더 선택" />

            <TextView
                android:id="@+id/text_archive_folder_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택된 폴더 없음"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 다운로드 폴더 -->
        <CheckBox
            android:id="@+id/cb_downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="다운로드 폴더" />

        <LinearLayout
            android:id="@+id/layout_downloads_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pick_downloads_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="폴더 선택" />

            <TextView
                android:id="@+id/text_downloads_folder_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택된 폴더 없음"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 설치 파일 (APK) -->
        <CheckBox
            android:id="@+id/cb_installer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="설치 파일 (APK)" />

        <LinearLayout
            android:id="@+id/layout_installer_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pick_installer_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="폴더 선택" />

            <TextView
                android:id="@+id/text_installer_folder_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택된 폴더 없음"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 기타 -->
        <CheckBox
            android:id="@+id/cb_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="기타" />

        <LinearLayout
            android:id="@+id/layout_other_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pick_other_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="폴더 선택" />

            <TextView
                android:id="@+id/text_other_folder_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택된 폴더 없음"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="사진 · 음악 · 음성 · 동영상 · 폴더지정 항목 정렬"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="용량이 큰 항목이라 도중에 끊겨도 중요한 파일이 먼저 넘어가도록 최신순이 기본입니다"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/radio_sort_order_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_sort_newest_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="최신순 (기본)" />

            <RadioButton
                android:id="@+id/radio_sort_oldest_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="오래된순" />

        </RadioGroup>

        <Button
            android:id="@+id/btn_connect_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="전송 시작" />

        <TextView
            android:id="@+id/text_category_index_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_category_send"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="전체 진행률"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress_overall_send"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/text_status_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
