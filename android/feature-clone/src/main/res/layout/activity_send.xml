<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결 방식"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_method_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_wifi_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="같은 Wi-Fi" />

            <RadioButton
                android:id="@+id/radio_hotspot_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="핫스팟" />

            <RadioButton
                android:id="@+id/radio_wifi_direct_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Direct (가장 빠름, 공유기 불필요)" />

            <RadioButton
                android:id="@+id/radio_relay_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인터넷 경유 (다른 네트워크에서도 가능, 느릴 수 있음)" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#33000000" />

        <LinearLayout
            android:id="@+id/layout_local_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_local_hint_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="두 폰이 같은 공유기 Wi-Fi에 연결되어 있어야 합니다"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="새 폰에 표시된 IP를 입력하세요"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edit_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="192.168.0.5"
                android:inputType="textUri"
                android:autofillHints="" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_wifi_direct_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_scan_peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주변 기기 검색" />

            <ListView
                android:id="@+id/list_peers"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_wifi_direct_status_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_relay_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="릴레이 서버 주소"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edit_relay_url_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textUri"
                android:autofillHints="" />

        </LinearLayout>

        <EditText
            android:id="@+id/edit_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="PIN 6자리"
            android:inputType="number"
            android:maxLength="6"
            android:autofillHints="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="보낼 데이터 선택"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="연락처" />

        <CheckBox
            android:id="@+id/cb_call_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="통화 기록" />

        <CheckBox
            android:id="@+id/cb_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="캘린더" />

        <CheckBox
            android:id="@+id/cb_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="문자 메시지" />

        <CheckBox
            android:id="@+id/cb_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="사진 / 동영상" />

        <CheckBox
            android:id="@+id/cb_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="설치된 앱 목록" />

        <CheckBox
            android:id="@+id/cb_sns_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="SNS 백업 파일 (카카오톡 · 라인 등)" />

        <LinearLayout
            android:id="@+id/layout_sns_backup_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="먼저 카카오톡·라인 등 앱의 '대화 백업/내보내기' 기능으로 백업 파일을 만든 뒤, 그 파일이 저장된 폴더를 선택하세요"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_pick_sns_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="폴더 선택" />

            <TextView
                android:id="@+id/text_sns_folder_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택된 폴더 없음"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_connect_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="전송 시작" />

        <TextView
            android:id="@+id/text_category_index_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_category_send"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="전체 진행률"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress_overall_send"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/text_status_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
